    "schedule",
    "explain",
    "cli",
    "human-readable",
    "eventbridge",
    "github-actions",
    "kubernetes"
  ],
  "license": "MIT",
  "author": "builtbyzero",
  "homepage": "https://builtbyzero.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbyzero/explain-cron.git"
  },
  "bugs": {
    "url": "https://github.com/builtbyzero/explain-cron/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
